BAIDU_MAP_AK=
BAIDU_MAP_SECRET=
BAIDU_MAP_MODE=mock
BAIDU_MAP_QPS=1.5
AMAP_WEB_SERVICE_KEY=
AMAP_VALIDATION_ENABLED=false
AMAP_QPS=1
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_BAIDU_MAP_AK=
VITE_API_BASE_URL=
LIFE_CIRCLE_DATABASE_PATH=
WALKING_CACHE_TTL_SECONDS=86400
WALKING_MAX_CONCURRENCY=6
WALKING_QPS=8
WALKING_TIMEOUT_SECONDS=8
WALKING_MAX_RETRIES=2
WALKING_RETRY_BASE_SECONDS=0.25
LIFE_CIRCLE_SEED_WALKING_CACHE=1

# 自然语言需求提取、报告解读和工具规划助手共享的可选模型配置。
# 工具问答要求模型服务支持原生 tools/tool_calls；仅文本接口会降级。
# 保持 false 时使用明确标注的规则解析、规则解读与规则工具。
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.5

# 中文语义嵌入仅产生待人工审核的候选；保持 false 时使用规则召回。
# openai_compatible 使用显式服务地址；local 需要预置本地模型和 sentence-transformers。
SEMANTIC_EMBEDDING_ENABLED=false
SEMANTIC_EMBEDDING_PROVIDER=openai_compatible
SEMANTIC_EMBEDDING_BASE_URL=
SEMANTIC_EMBEDDING_MODEL=
SEMANTIC_EMBEDDING_API_KEY=
SEMANTIC_EMBEDDING_MODEL_PATH=

# 原生步行等时圈需另行核验账号权限与费用；关闭时保留径向路线采样。
BAIDU_NATIVE_ISOCHRONE_ENABLED=false

# 图片OCR默认关闭；关闭或失败时仍保留原图供人工复核。
# 请求/响应契约见 docs/governance/ai-first-governance-and-evaluation.md。
OBSERVATION_OCR_ENABLED=false
OBSERVATION_OCR_ENDPOINT=
OBSERVATION_OCR_API_KEY=

# 可选外部规范JSON；须含来源、版本、适用范围和人工核验信息。
# Docker填写容器内文件路径，并通过本地compose覆盖文件只读挂载该文件。
# 留空时仅引用项目ADR，并明确标记为项目规则。
LIFE_CIRCLE_NORMS_PATH=

# 执行账本费用为估算；人工核验全部执行费用后可录入结算记录。价格留空表示未知。
# 地图计价只选 request 或 route_pair，嵌入只选 request 或 tokens，避免双算。
# 单位留空时仅配置一个对应价格可自动推断；双价格或无价格不会推断。
MAP_PRICING_UNIT=
MAP_REQUEST_PRICE_CNY=
ROUTE_PAIR_PRICE_CNY=
EMBEDDING_PRICING_UNIT=
EMBEDDING_REQUEST_PRICE_CNY=
EMBEDDING_PRICE_CNY_PER_MILLION=

# 原生等时圈单独计价，其HTTP请求不会再按普通地图请求双算。
# OCR按请求计价；LLM分别按输入、输出token计价。
NATIVE_ISOCHRONE_PRICE_CNY=
OCR_REQUEST_PRICE_CNY=
LLM_INPUT_PRICE_CNY_PER_MILLION=
LLM_OUTPUT_PRICE_CNY_PER_MILLION=
